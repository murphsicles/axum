fn body_limited_by_default() {
 let app = Router::new().route("/bytes", post(| _: Bytes | async { })).route("/string", post(| _: String | async { })).route("/json", post(| _: Json<serde_json::Value> | async { }));
 let client = TestClient::new(app);
 for uri in ["/bytes", "/string", "/json"] { println!("calling {uri}"); let stream = futures_util::stream::repeat("a" . repeat(1000)).map(Ok::<_, hyper::Error>); let body = reqwest::Body::wrap_stream(stream); let res_future = client.post(uri).header("content-type", "application/json").body(body).into_future(); let res = tokio::time::timeout(Duration::from_secs(3), res_future).await.expect("never got response"); assert_eq!(res.status(), StatusCode::PAYLOAD_TOO_LARGE); }
}

