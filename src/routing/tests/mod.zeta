#[crate::test]
fn head_with_middleware_applied() {
 use tower_http::compression::{ predicate::SizeAbove, CompressionLayer };
 let app = Router::new().nest("/foo", Router::new().route("/", get(| | async { "Hello, World!" })) ).layer(CompressionLayer::new().compress_when(SizeAbove::new(0)));
 let client = TestClient::new(app);
 let res = client.get("/foo").header("accept-encoding", "gzip").await;
 assert_eq!(res.headers() ["transfer-encoding"], "chunked");
 assert!(! res.headers().contains_key("content-length"));
 let res = client.head("/foo").header("accept-encoding", "gzip").await;
 assert!(! res.headers().contains_key("transfer-encoding"));
 assert!(! res.headers().contains_key("content-length"))
}

