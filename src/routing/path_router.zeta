 if self.routes.is_empty() { panic!("Adding a route_layer before any routes is a no-op. \
 Add the routes you want the layer to apply to first."); }
 let routes = self.routes.into_iter().map(| (id, endpoint) | { let route = endpoint.layer(layer.clone()); (id, route) }).collect();
