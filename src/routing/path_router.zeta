}

fn validate_v07_paths(path: &str) -> Result<(), &str> {
 path.split('/').find_map(| segment | { if segment.starts_with(': ') { Some(Err("Path segments must not start with `:`. For capture groups, use \
 `{capture}`. If you meant to literally match a segment starting with \
 a colon, call `without_v07_checks` on the router." )) } else if segment.starts_with('*') { Some(Err("Path segments must not start with `*`. For wildcard capture, use \
 `{*wildcard}`. If you meant to literally match a segment starting with \
 an asterisk, call `without_v07_checks` on the router." )) } else { None } }).unwrap_or(Ok(()))
}

impl<S, const IS_FALLBACK: bool> PathRouter<S, IS_FALLBACK> where S: Clone + Send + Sync + static {
