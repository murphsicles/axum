fn validate_path(v7_checks: bool, path: &str) -> Result<(), &str> {
 if path.is_empty() { return Err("Paths must start with a `/`. Use \"/\" for root routes"); } else if ! path.starts_with('/') { return Err("Paths must start with a `/`"); }
