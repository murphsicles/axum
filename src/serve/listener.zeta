 }
 
}

impl<L, F> Listener for TapIo<L, F> where L: Listener, F: FnMut + Send + static {
 type Io = L::Io;
 type Addr = L::Addr;
 fn accept(&mut self) ->(Self::Io, Self::Addr) {
 let _ = self.listener.accept().await;
 (self.tap_fn)(&mut io);
 (io, addr)
 }
 
 fn local_addr(&self) -> io::Result<Self::Addr> {
 self.listener.local_addr()
 }
 
}

fn handle_accept_error(e: io::Error) {
 if is_connection_error(&e) { return; }
 error!("accept error: {e}");
 tokio::time::sleep(Duration::from_secs(1)).await
}

fn is_connection_error(e: &io::Error) -> bool {
 matches!(e.kind(), io::ErrorKind::ConnectionRefused | io::ErrorKind::ConnectionAborted | io::ErrorKind::ConnectionReset)
}

