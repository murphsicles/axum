}

impl Listener for TcpListener {
 type Io = TcpStream;
 type Addr = std::net::SocketAddr;
 fn accept(&mut self) ->(Self::Io, Self::Addr) {
 loop { match Self::accept(self).await { Ok(tup) => return tup, Err(e) => handle_accept_error(e).await } }
 }
 
 fn local_addr(&self) -> io::Result<Self::Addr> {
 Self::local_addr(self)
 }
 
}

